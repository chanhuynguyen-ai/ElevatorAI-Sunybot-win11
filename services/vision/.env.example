# Hardware-free defaults. Change these for a real deployment.
CV_BACKEND=mock
CAMERA_SOURCE=mock
CV_DB_ENABLED=false
ENABLE_POSE=false
ENABLE_FACE=false
CAMERA_ID=CAM_01
API_HOST=0.0.0.0
API_PORT=8010

# PostgreSQL (required when CV_DB_ENABLED=true)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=elevator_cv
PG_USER=elevator_ai
PG_PASSWORD=change-me

# Laptop inference
CV_DEVICE=auto
DET_MODEL_DEV=./models/yolov8n.pt
POSE_MODEL_DEV=./models/yolov8n-pose.pt

# Jetson TensorRT
DET_ENGINE_PATH=./models/yolov8n_fp16.engine
POSE_ENGINE_PATH=./models/yolov8n_pose_fp16.engine
